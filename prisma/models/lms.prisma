model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  email                 String    @unique
  firstName             String?
  lastName              String?
  headline              String?
  biography             String?
  link_website          String?
  link_x                String?
  link_linkedin         String?
  link_instagram        String?
  link_facebook         String?
  link_tiktok           String?
  link_youtube          String?
  link_github           String?
  passwordHash          String
  isActive              Boolean   @default(true)
  emailVerifiedAt       DateTime?
  verificationToken     String?
  resetPasswordToken    String?
  resetPasswordTokenExp DateTime?
  refreshTokenHash      String?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorSecret       String?
  twoFactorTempSecret   String?
  twoFactorBackupHashes Json?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  roles                 UserRole[]
  courses               Course[]          @relation("EducatorCourses")
  cart                  Cart?
  orders                Order[]
  orderItemsAsEducator  OrderItem[]
  wishlists             Wishlist[]
  enrollments           Enrollment[]
  reviews               Review[]
  reviewLikes           ReviewLike[]
  courseProgressRecords CourseProgress[]
  lessonProgress        LessonProgress[]
  notifications         Notification[]
  communityMemberships  CommunityMember[]
  communityPosts        CommunityPost[]
  communityComments     CommunityComment[]
  communityReactions    CommunityReaction[]
  communityReports      CommunityReport[]
  payoutAccount         PayoutAccount?
  payoutRequests        PayoutRequest[]   @relation("EducatorPayoutRequests")
  reviewedPayouts       PayoutRequest[]   @relation("AdminReviewedPayoutRequests")
  approvedCourses       Course[]          @relation("CourseApprovedByAdmin")
  submittedCourses      CourseSubmission[]
  taxTransactions       TaxTransaction[]
  createdMedia          Media[]
  activityEvents        ActivityEvent[]
  trustedDevices        TrustedDevice[]
  createdCoupons        Coupon[]          @relation("CouponCreator")
  discussionThreads     DiscussionThread[] @relation("DiscussionAuthor")
  discussionReplies     DiscussionReply[]  @relation("DiscussionReplyAuthor")
  discussionThreadVotes DiscussionThreadVote[] @relation("DiscussionThreadVoter")
  resolvedDiscussionThreads DiscussionThread[] @relation("DiscussionResolver")
  chatConversationMemberships ChatConversationParticipant[]
  createdChatConversations ChatConversation[] @relation("ChatConversationCreator")
  sentChatMessages ChatMessage[] @relation("ChatMessageSender")
  hiddenChatMessages ChatMessageHidden[]
  nudgeRules            CourseNudgeRule[] @relation("CourseNudgeRuleOwner")
  sentNudgeLogs         CourseNudgeLog[]  @relation("NudgeSentByEducator")
  receivedNudgeLogs     CourseNudgeLog[]  @relation("NudgeRecipient")
  sentFriendRequests    FriendRequest[]   @relation("FriendRequestRequester")
  receivedFriendRequests FriendRequest[]  @relation("FriendRequestAddressee")
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  entitlements          Entitlement[]
  trialEvents           TrialEvent[]
  subscriptions         Subscription[]
  watchSessionsAsLearner WatchSession[]   @relation("WatchSessionLearner")
  watchSessionsAsEducator WatchSession[]  @relation("WatchSessionEducator")
  educatorEarnings      EducatorEarning[]

  @@index([deletedAt])
  @@map("users")
}

model FriendRequest {
  id          String              @id @default(cuid())
  requesterId String
  addresseeId String
  userAId     String
  userBId     String
  status      FriendRequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requester   User                @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User                @relation("FriendRequestAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([requesterId, status, createdAt])
  @@index([addresseeId, status, createdAt])
  @@map("friend_requests")
}

model TrustedDevice {
  id               String    @id @default(cuid())
  userId           String
  deviceIdentifier String?
  tokenDigest      String    @unique
  deviceName       String
  userAgent        String?
  ipAddress        String?
  locationLabel    String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastUsedAt])
  @@index([userId, deviceIdentifier, revokedAt])
  @@map("trusted_devices")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  image       String?
  icon        String?
  color       String?
  description String?
  parentId    String?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  courses     Course[]
  topics      Topic[]

  @@unique([name, parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Topic {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String   @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  lessonTopics LessonTopic[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("topics")
}

model CourseLevel {
  id        String   @id @default(cuid())
  title     String   @unique
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courses   Course[]

  @@map("course_levels")
}

model CoursePriceTier {
  id        String    @id @default(cuid())
  title     String    @unique
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  courses   Course[]

  @@map("course_price_tiers")
}

model Course {
  id                  String               @id @default(cuid())
  educatorId          String
  categoryId          String?
  approvedById        String?
  levelId             String?
  priceTierId         String?
  title               String
  subtitle            String?
  slug                String               @unique
  description         String?
  welcomeMessage      String?
  congratulationsMessage String?
  language            String?              @default("en")
  workflowStatus      CourseWorkflowStatus @default(DRAFT)
  isPublished         Boolean              @default(false)
  isDraftDeletable    Boolean              @default(true)
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectedReason      String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  educator            User                 @relation("EducatorCourses", fields: [educatorId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  level               CourseLevel?         @relation(fields: [levelId], references: [id])
  priceTier           CoursePriceTier?     @relation(fields: [priceTierId], references: [id])
  approvedBy          User?                @relation("CourseApprovedByAdmin", fields: [approvedById], references: [id])
  sections            CourseSection[]
  lessons             Lesson[]
  cartItems           CartItem[]
  wishlists           Wishlist[]
  orderItems          OrderItem[]
  enrollments         Enrollment[]
  community           CourseCommunity?
  reviews             Review[]
  progress            CourseProgress[]
  media               Media[]
  submissions         CourseSubmission[]
  activityEvents      ActivityEvent[]
  coupons             Coupon[]
  nudgeRule           CourseNudgeRule?
  nudgeLogs           CourseNudgeLog[]
  discussionThreads   DiscussionThread[]
  trialEligible       Boolean              @default(false)
  subscriptionEligible Boolean             @default(false)
  trialOptInAt        DateTime?
  trialEvents         TrialEvent[]
  watchSessions       WatchSession[]
  educatorEarnings    EducatorEarning[]

  @@index([educatorId, workflowStatus])
  @@index([categoryId])
  @@index([priceTierId])
  @@index([deletedAt])
  @@map("courses")
}

model CourseSubmission {
  id        String     @id @default(cuid())
  courseId  String
  userId    String
  note      String?
  createdAt DateTime   @default(now())

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("course_submissions")
}

model CourseSection {
  id          String    @id @default(cuid())
  courseId     String
  title        String
  description  String?
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id                 String      @id @default(cuid())
  sectionId          String
  courseId           String
  topicId            String?
  type               LessonType
  title              String
  description        String?
  position           Int
  durationInSeconds  Int         @default(0)
  isPreview          Boolean     @default(false)
  unlockType         LessonUnlockType @default(IMMEDIATE)
  unlockAt           DateTime?
  prerequisiteLessonId String?
  videoUrl           String?
  resourceUrl        String?
  assignmentText     String?
  codingInstructions String?
  codingStarterCode  String?
  quizQuestions      Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  section            CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic              Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  prerequisiteLesson Lesson?       @relation("LessonPrerequisite", fields: [prerequisiteLessonId], references: [id], onDelete: SetNull)
  dependentLessons   Lesson[]      @relation("LessonPrerequisite")
  lessonTopics       LessonTopic[]
  progress           LessonProgress[]
  media              Media[]
  videoUpload        LessonVideoUpload?
  discussionThreads  DiscussionThread[]

  @@unique([sectionId, position])
  @@index([courseId])
  @@index([topicId])
  @@index([prerequisiteLessonId])
  @@map("lessons")
}

model LessonVideoUpload {
  id                String   @id @default(cuid())
  lessonId          String   @unique
  userId            String
  providerVideoId   String
  uploadUrl         String
  fileName          String
  mimeType          String   @default("video/mp4")
  sizeInBytes       BigInt
  durationInSeconds Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_video_uploads")
}

model CourseNudgeRule {
  id                        String   @id @default(cuid())
  courseId                  String   @unique
  educatorId                String
  inactivityDaysThreshold   Int      @default(7)
  lowProgressThreshold      Int      @default(50)
  enabledInactivityNudge    Boolean  @default(true)
  enabledLowProgressNudge   Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  course                    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  educator                  User     @relation("CourseNudgeRuleOwner", fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId])
  @@map("course_nudge_rules")
}

model CourseNudgeLog {
  id            String   @id @default(cuid())
  courseId      String
  enrollmentId  String?
  learnerId     String
  sentById      String?
  triggerType   String
  status        String   @default("SENT")
  message       String
  metadata      Json?
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment    Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  learner       User        @relation("NudgeRecipient", fields: [learnerId], references: [id], onDelete: Cascade)
  sentBy        User?       @relation("NudgeSentByEducator", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([courseId, triggerType, sentAt])
  @@index([learnerId, sentAt])
  @@index([enrollmentId])
  @@map("course_nudge_logs")
}

model DiscussionThread {
  id            String   @id @default(cuid())
  courseId      String
  lessonId      String
  authorId      String
  category      DiscussionCategory @default(COURSE_CONTENT)
  title         String
  body          String
  imagePath     String?
  isResolved    Boolean  @default(false)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author        User     @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  resolvedBy    User?    @relation("DiscussionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  replies       DiscussionReply[]
  votes         DiscussionThreadVote[]

  @@index([courseId, lessonId, createdAt])
  @@index([authorId, createdAt])
  @@index([resolvedById])
  @@map("discussion_threads")
}

model DiscussionThreadVote {
  id        String   @id @default(cuid())
  threadId  String
  voterId   String
  createdAt DateTime @default(now())

  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  voter     User             @relation("DiscussionThreadVoter", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([threadId, voterId])
  @@index([voterId, createdAt])
  @@map("discussion_thread_votes")
}

model DiscussionReply {
  id            String   @id @default(cuid())
  threadId      String
  authorId      String
  body          String
  parentReplyId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  thread        DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author        User             @relation("DiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentReply   DiscussionReply? @relation("DiscussionReplyHierarchy", fields: [parentReplyId], references: [id], onDelete: SetNull)
  replies       DiscussionReply[] @relation("DiscussionReplyHierarchy")

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentReplyId])
  @@map("discussion_replies")
}

model ChatConversation {
  id            String   @id @default(cuid())
  createdById   String?
  isGroup       Boolean  @default(false)
  title         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  createdBy     User?    @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants  ChatConversationParticipant[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
  @@map("chat_conversations")
}

model ChatConversationParticipant {
  id                String   @id @default(cuid())
  conversationId    String
  userId            String
  joinedAt          DateTime @default(now())
  lastReadAt        DateTime?
  nickname          String?  // shared display nickname for this user in this conversation
  photoMediaId      String?  // conversation-scoped avatar override for this user (media ID)
  backgroundMediaId String?  // my chat background for this conversation (only the row owner reads it)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, updatedAt])
  @@index([conversationId, updatedAt])
  @@map("chat_conversation_participants")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String?
  mediaPath      String?
  mediaType      String?
  messageType    ChatMessageType @default(USER)
  metadata       Json?          // structured payload for system messages
  deletedForEveryoneAt DateTime?
  deletedForEveryoneById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  hiddenFor      ChatMessageHidden[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([deletedForEveryoneAt])
  @@map("chat_messages")
}

model ChatMessageHidden {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@index([messageId])
  @@map("chat_message_hidden")
}

model LessonTopic {
  id        String   @id @default(cuid())
  lessonId  String
  topicId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([lessonId, topicId])
  @@index([lessonId])
  @@index([topicId])
  @@map("lesson_topics")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
  @@index([courseId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("wishlists")
}

model Coupon {
  id          String      @id @default(cuid())
  courseId    String?
  createdById String?
  code        String      @unique
  type        CouponType
  value       Decimal     @db.Decimal(10, 2)
  maxDiscount Decimal?    @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  usedCount   Int         @default(0)
  isActive    Boolean     @default(true)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  course      Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([courseId])
  @@index([createdById])
  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
  @@map("coupons")
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  couponId         String?
  status           OrderStatus @default(CREATED)
  subtotalAmount   Decimal     @db.Decimal(10, 2)
  discountAmount   Decimal     @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal     @default(0) @db.Decimal(10, 2)
  platformFeeAmount Decimal    @default(0) @db.Decimal(10, 2)
  educatorEarnings Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal     @db.Decimal(10, 2)
  currency         String      @default("PHP")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id])
  coupon           Coupon?     @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  payment          Payment?
  enrollments      Enrollment[]
  taxTransaction   TaxTransaction?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  courseId           String
  educatorId         String
  unitPrice          Decimal   @db.Decimal(10, 2)
  discountAmount     Decimal   @default(0) @db.Decimal(10, 2)
  taxableAmount      Decimal   @db.Decimal(10, 2)
  taxAmount          Decimal   @default(0) @db.Decimal(10, 2)
  platformFeePercent Decimal   @default(0) @db.Decimal(5, 2)
  platformFeeAmount  Decimal   @default(0) @db.Decimal(10, 2)
  educatorEarning    Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal   @db.Decimal(10, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course             Course    @relation(fields: [courseId], references: [id])
  educator           User      @relation(fields: [educatorId], references: [id])
  enrollments        Enrollment[]
  payoutItems        PayoutRequestItem[]

  @@index([orderId])
  @@index([educatorId])
  @@unique([orderId, courseId])
  @@map("order_items")
}

model Payment {
  id                 String          @id @default(cuid())
  orderId            String          @unique
  provider           PaymentProvider @default(PAYPAL)
  providerOrderId    String          @unique
  providerCaptureId  String?         @unique
  status             PaymentStatus   @default(CREATED)
  payerEmail         String?
  payerId            String?
  rawResponse        Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  capturedAt         DateTime?

  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  orderId         String?
  orderItemId     String?
  status          EnrollmentStatus @default(ACTIVE)
  accessSource    EnrollmentAccessSource @default(PURCHASE)
  accessEndsAt    DateTime?
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem?       @relation(fields: [orderItemId], references: [id])
  review          Review?
  courseProgress  CourseProgress?
  lessonProgress  LessonProgress[]
  nudgeLogs       CourseNudgeLog[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model Review {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrollmentId String   @unique
  rating      Int
  title       String?
  comment     String?
  authorReply String?
  authorReplyAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment  Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reviewLikes ReviewLike[]

  @@unique([userId, courseId])
  @@index([courseId, rating])
  @@map("reviews")
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId, createdAt])
  @@map("review_likes")
}

model CourseProgress {
  id            String     @id @default(cuid())
  enrollmentId  String     @unique
  courseId      String
  userId        String
  progressPct   Decimal    @default(0) @db.Decimal(5, 2)
  completedLessons Int     @default(0)
  totalLessons  Int        @default(0)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
  @@map("course_progress")
}

model LessonProgress {
  id            String      @id @default(cuid())
  enrollmentId  String
  lessonId      String
  userId        String
  isCompleted   Boolean     @default(false)
  progressPct   Decimal     @default(0) @db.Decimal(5, 2)
  lastPosition  Int         @default(0)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson        Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([userId, lessonId])
  @@map("lesson_progress")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model ActivityEvent {
  id         String            @id @default(cuid())
  eventType  ActivityEventType
  userId     String?
  courseId   String?
  pagePath   String?
  sessionKey String?
  metadata   Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  course     Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([eventType, createdAt])
  @@index([sessionKey, createdAt])
  @@map("activity_events")
}

model PayoutAccount {
  id                   String    @id @default(cuid())
  userId               String    @unique
  paypalEmail          String
  paypalMerchantId     String?
  isVerified           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paypalEmail])
  @@map("payout_accounts")
}

model PayoutRequest {
  id                  String       @id @default(cuid())
  educatorId          String
  reviewedById        String?
  amount              Decimal      @db.Decimal(10, 2)
  currency            String       @default("PHP")
  status              PayoutStatus @default(REQUESTED)
  note                String?
  reviewNote          String?
  paypalBatchId       String?
  requestedAt         DateTime     @default(now())
  reviewedAt          DateTime?
  executedAt          DateTime?
  calculationSnapshot Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  educator            User         @relation("EducatorPayoutRequests", fields: [educatorId], references: [id], onDelete: Cascade)
  reviewedBy          User?        @relation("AdminReviewedPayoutRequests", fields: [reviewedById], references: [id])
  items               PayoutRequestItem[]
  events              PayoutRequestEvent[]
  earnings            EducatorEarning[]

  @@index([educatorId, status, requestedAt])
  @@index([reviewedById])
  @@map("payout_requests")
}

model PayoutRequestEvent {
  id              String        @id @default(cuid())
  payoutRequestId String
  eventType       String
  occurredAt      DateTime      @default(now())
  payload         Json?
  createdAt       DateTime      @default(now())

  payoutRequest   PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)

  @@index([payoutRequestId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("payout_request_events")
}

model PayoutRequestItem {
  id             String        @id @default(cuid())
  payoutRequestId String
  orderItemId    String
  amount         Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())

  payoutRequest  PayoutRequest @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  orderItem      OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([payoutRequestId, orderItemId])
  @@map("payout_request_items")
}

model TaxRegion {
  id            String     @id @default(cuid())
  code          String     @unique
  countryCode   String
  stateCode     String?
  city          String?
  postalPattern String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  rates         TaxRate[]
  transactions  TaxTransaction[]

  @@index([countryCode, stateCode, isActive])
  @@map("tax_regions")
}

model TaxRate {
  id            String    @id @default(cuid())
  regionId      String
  taxType       TaxType
  ratePercent   Decimal   @db.Decimal(5, 2)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  region        TaxRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId, taxType, isActive])
  @@map("tax_rates")
}

model TaxTransaction {
  id             String    @id @default(cuid())
  orderId        String    @unique
  userId         String
  regionId       String?
  taxableAmount  Decimal   @db.Decimal(10, 2)
  taxAmount      Decimal   @db.Decimal(10, 2)
  totalAmount    Decimal   @db.Decimal(10, 2)
  currency       String    @default("PHP")
  breakdown      Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  region         TaxRegion? @relation(fields: [regionId], references: [id])

  @@index([userId, createdAt])
  @@index([regionId])
  @@map("tax_transactions")
}

model PlatformSetting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("platform_settings")
}

model Media {
  id            String    @id @default(cuid())
  userId        String
  courseId      String?
  lessonId      String?
  storagePath   String
  originalName  String
  mimeType      String
  mediaType     String
  sizeInBytes   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson        Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([lessonId])
  @@map("media")
}

model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  source    EntitlementSource
  startsAt  DateTime          @default(now())
  endsAt    DateTime
  revokedAt DateTime?
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
  @@map("entitlements")
}

model TrialEvent {
  id        String         @id @default(cuid())
  userId    String
  courseId  String?
  type      TrialEventType
  metadata  Json?
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([courseId, type])
  @@map("trial_events")
}

model TrialSignupFingerprint {
  id        String   @id @default(cuid())
  ipHash    String
  userId    String?
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@map("trial_signup_fingerprints")
}

model Plan {
  id               String         @id @default(cuid())
  name             String
  interval         PlanInterval
  price            Decimal        @db.Decimal(10, 2)
  firstCyclePrice  Decimal?       @db.Decimal(10, 2)
  currency         String         @default("PHP")
  isActive         Boolean        @default(true)
  paypalPlanId     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions    Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(PENDING)
  paypalSubscriptionId String?            @unique
  provider             String             @default("PAYPAL")
  xenditCustomerId     String?
  xenditSessionId      String?            @unique
  xenditPlanId         String?            @unique
  xenditTokenId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  invoices             SubscriptionInvoice[]

  @@index([userId, status])
  @@index([xenditCustomerId])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id              String                    @id @default(cuid())
  subscriptionId  String
  externalId      String                    @unique
  amount          Decimal                   @db.Decimal(10, 2)
  taxAmount       Decimal                   @default(0) @db.Decimal(10, 2)
  netAmount       Decimal                   @db.Decimal(10, 2)
  currency        String                    @default("PHP")
  status          SubscriptionInvoiceStatus @default(PAID)
  paidAt          DateTime                  @default(now())
  createdAt       DateTime                  @default(now())

  subscription    Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([paidAt])
  @@map("subscription_invoices")
}

model WatchSession {
  id         String   @id @default(cuid())
  userId     String
  educatorId String
  courseId   String
  lessonId   String
  day        DateTime @db.Date
  seconds    Int      @default(0)
  source     EnrollmentAccessSource
  lastBeatAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation("WatchSessionLearner", fields: [userId], references: [id], onDelete: Cascade)
  educator   User     @relation("WatchSessionEducator", fields: [educatorId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, day])
  @@index([day, source])
  @@index([educatorId, day])
  @@map("watch_sessions")
}

model EarningsCycle {
  id            String              @id @default(cuid())
  month         String              @unique
  status        EarningsCycleStatus @default(OPEN)
  netRevenue    Decimal             @default(0) @db.Decimal(12, 2)
  poolPercent   Decimal             @default(0) @db.Decimal(5, 2)
  poolAmount    Decimal             @default(0) @db.Decimal(12, 2)
  totalSeconds  Int                 @default(0)
  calculatedAt  DateTime?
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  earnings      EducatorEarning[]

  @@map("earnings_cycles")
}

model EducatorEarning {
  id              String                @id @default(cuid())
  educatorId      String
  cycleId         String?
  courseId        String?
  type            EducatorEarningType
  status          EducatorEarningStatus @default(PENDING)
  amount          Decimal               @db.Decimal(12, 2)
  seconds         Int                   @default(0)
  dedupeKey       String                @unique
  payoutRequestId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  educator        User                  @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  cycle           EarningsCycle?        @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  course          Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  payoutRequest   PayoutRequest?        @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([educatorId, status])
  @@index([cycleId])
  @@map("educator_earnings")
}

model CourseCommunity {
  id          String   @id @default(cuid())
  courseId    String   @unique
  name        String
  description String?
  photoUrl    String?
  coverUrl    String?
  themeColor  String   @default("#2563eb")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       CommunityPost[]
  reports     CommunityReport[]

  @@map("course_communities")
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        String    @default("MEMBER")
  badge       String?
  bannedAt    DateTime?
  bannedUntil DateTime?
  banReason   String?
  joinedAt    DateTime  @default(now())

  community   CourseCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId, role])
  @@map("community_members")
}

model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  authorId    String
  body        String
  imageUrl    String?
  imageUrls   String[]  @default([])
  pinned      Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  community   CourseCommunity    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    CommunityComment[]
  reactions   CommunityReaction[]

  @@index([communityId, pinned, createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id        String    @id @default(cuid())
  postId    String
  parentId  String?
  mediaIndex Int?
  authorId  String
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  post      CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    CommunityComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentId])
  @@map("community_comments")
}

model CommunityReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("community_reactions")
}

model CommunityReport {
  id          String    @id @default(cuid())
  communityId String
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  status      String    @default("OPEN")
  resolvedById String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  community   CourseCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporter    User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([communityId, status, createdAt])
  @@map("community_reports")
}
